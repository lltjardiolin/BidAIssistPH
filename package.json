{
  "name": "bidaissistph",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "corpus:download": "node scripts/download-corpus.mjs",
    "corpus:validate": "node scripts/validate-corpus.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "corpus:ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "eval": "tsx --env-file-if-exists=.env.local evaluation/run-eval.ts",
    "corpus:approve": "node scripts/approve-sources.mjs",
    "corpus:release-check": "node scripts/validate-corpus.mjs --release",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:backup": "bash scripts/backup-db.sh",
    "bench": "tsx --env-file-if-exists=.env.local scripts/bench.ts",
    "notices:sync": "tsx --env-file-if-exists=.env.local scripts/sync-philgeps.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.57",
    "@ai-sdk/otel": "1.0.118",
    "@ai-sdk/react": "4.0.121",
    "@opentelemetry/api": "1.9.1",
    "@vercel/otel": "2.1.3",
    "ai": "7.0.118",
    "cheerio": "1.2.0",
    "logfire": "0.22.9",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pgvector": "0.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "type": "module"
}
