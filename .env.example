# development | staging | production. Production refuses the mock model.
APP_ENV=development
# Chat model: openai (hosted deployment) | minimax | mock (offline extractive stand-in, dev/CI only)
LLM_PROVIDER=openai
MINIMAX_API_KEY=
MINIMAX_MODEL=minimax-m3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only for gpt-5 / o-series models: minimal | low | medium | high (default low)
OPENAI_REASONING_EFFORT=
# Only for gpt-5 / o-series models: total completion budget incl. reasoning (default MAX_OUTPUT_TOKENS + 3000)
OPENAI_MAX_COMPLETION_TOKENS=
# Embeddings: openai | openai-compatible (set EMBEDDING_BASE_URL). Pinned per corpus release.
# OpenAI example: openai / text-embedding-3-small / 1536 (re-embed + new corpus release when these change)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
DATABASE_URL=
# Evaluation judge (must differ from the model under test): an OpenAI-compatible endpoint
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
# Retrieval timeout in ms (default 4000).
RETRIEVAL_TIMEOUT_MS=
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_SALT=
# Trusted reverse proxies in front of the app (Caddy/nginx = 1)
RATE_LIMIT_PROXY_HOPS=1
# --- Answer tuning (leave empty for the defaults) ---
# direct = the server writes the search call itself instead of letting the model call the tool
TOOL_CALL_MODE=
EVIDENCE_TOP_K=
EVIDENCE_MAX=
EVIDENCE_MAX_CHARS=
MAX_OUTPUT_TOKENS=
# Questions answered at the same time before new ones get "busy, try again" (0 = no limit)
MAX_CONCURRENT_CHATS=
# --- Tracing (Logfire over OpenTelemetry). Leave the endpoint empty to send nothing. ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=<write token>  (server only; never NEXT_PUBLIC_)
OTEL_EXPORTER_OTLP_HEADERS=
LOGFIRE_SERVICE_NAME=bidaissistph
# true = also record visitors' questions, retrieved passages and answers in traces
TRACE_CONTENT=false
